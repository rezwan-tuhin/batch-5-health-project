# ---- Wallet (Phase 1) -------------------------------------------------------
# https://cloud.walletconnect.com -> New Project -> copy the projectId.
# Empty falls back to RainbowKit's public demo id (dev only).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional Alchemy/Infura RPC. Empty uses the public Sepolia RPC.
NEXT_PUBLIC_RPC_URL=

# ---- HealthRecordSystem contract (Phase 2) ----------------------------------
# Address of the deployed contract. The chain is whatever src/lib/wagmi.ts
# configures (currently Sepolia — no override here; it's the single source of
# truth for the client's network). Empty / invalid => chain writes degrade
# gracefully (DB-first, amber notice).
NEXT_PUBLIC_CONTRACT_ADDRESS=

# ---- IPFS (Phase 3) ---------------------------------------------------------
# Real content-addressed storage for anchored PDFs. Leave everything empty to
# keep the Phase 1/2 simulated CIDs (records still anchor, just not pinned).
#
# Backend used for uploads:
#   "http"   (default) — any Kubo-compatible API endpoint for POST /api/v0/add.
#            Point IPFS_API_URL at a local node (http://127.0.0.1:5001), Infura
#            (https://ipfs.infura.io:5001 with IPFS_API_TOKEN = project:secret),
#            or a Helia/Kubo relay. No token required for a local node.
#   "pinata" — Pinata v3 uploads (https://uploads.pinata.cloud/v3/files) using a
#            JWT from https://app.pinata.cloud (Settings -> API Keys).
IPFS_BACKEND=http
IPFS_API_URL=http://127.0.0.1:5001
IPFS_API_TOKEN=

# Public gateway used by the browser to open/read documents (client-visible).
# Defaults to https://ipfs.io when empty.
NEXT_PUBLIC_IPFS_READ_GATEWAY=https://ipfs.io